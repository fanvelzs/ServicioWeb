<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="1040.0" minHeight="400.0" minWidth="760.0"
      spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.servicioweb.UsuarioController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="20.0" left="24.0"/>
    </padding>

    <VBox spacing="6.0">
        <Label text="Consulta de usuarios">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
        <Label text="Consulta los datos de contacto, la ciudad y la empresa de cada usuario."
               wrapText="true"/>
    </VBox>

    <Separator/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Buscar:" labelFor="${txtBuscar}"/>
        <TextField fx:id="txtBuscar" promptText="Nombre, usuario o correo"
                   prefWidth="340.0" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConsultar" text="Consultar usuarios" mnemonicParsing="false"
                onAction="#consultarUsuarios"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="55.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180.0"/>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="130.0"/>
            <TableColumn fx:id="colEmail" text="Correo electrónico" prefWidth="205.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150.0"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120.0"/>
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="150.0"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="8.0">
                <Label fx:id="lblSinUsuarios" text="Sin usuarios para mostrar">
                    <font>
                        <Font size="16.0"/>
                    </font>
                </Label>
                <Label fx:id="lblAyudaTabla" text="Los resultados de la consulta aparecerán aquí."/>
            </VBox>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="lblEstado" text="Sin consulta"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalUsuarios" text="0 usuarios"/>
    </HBox>
</VBox>
